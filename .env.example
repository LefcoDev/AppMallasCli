# =================================================
# CONFIGURACIÓN DE BASE DE DATOS
# =================================================

# Tipo de base de datos (oracle, mysql, postgres)
DB_TYPE=oracle

# =================================================
# CONFIGURACIÓN ORACLE
# =================================================

# Conexión Oracle usando oracledb driver
ORACLE_USER=hr
ORACLE_PASSWORD=password
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_DATABASE=XE
ORACLE_SCHEMA=HR
ORACLE_CONNECT_STRING=localhost:1521/XE

# Configuración Oracle para desarrollo
ORACLE_DEV_USER=dev_user
ORACLE_DEV_PASSWORD=dev_password
ORACLE_DEV_CONNECT_STRING=localhost:1521/XEPDB1

# =================================================
# CONFIGURACIÓN MYSQL (ALTERNATIVA)
# =================================================

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=test_db

# =================================================
# CONFIGURACIÓN POSTGRESQL (ALTERNATIVA)
# =================================================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DATABASE=test_db

# =================================================
# CONFIGURACIÓN GENERAL
# =================================================

# Entorno de ejecución
NODE_ENV=development

# Configuración de zona horaria
DB_TIMEZONE=+00:00

# =================================================
# CONFIGURACIÓN DE POOL DE CONEXIONES ORACLE
# =================================================

# Número mínimo de conexiones en el pool
ORACLE_POOL_MIN=1

# Número máximo de conexiones en el pool
ORACLE_POOL_MAX=10

# Incremento de conexiones en el pool
ORACLE_POOL_INCREMENT=1

# Timeout del pool en segundos
ORACLE_POOL_TIMEOUT=60

# Intervalo de ping del pool en segundos
ORACLE_POOL_PING_INTERVAL=60

# =================================================
# CONFIGURACIÓN DE RENDIMIENTO ORACLE
# =================================================

# Tamaño del cache de statements
ORACLE_STMT_CACHE_SIZE=30

# Máximo de elementos en cola
ORACLE_QUEUE_MAX=500

# Timeout de cola en milisegundos
ORACLE_QUEUE_TIMEOUT=60000

# =================================================
# CONFIGURACIÓN CLI
# =================================================

# Tipo de interfaz CLI a usar: 'inquirer' o 'readline'
CLI_TYPE=inquirer

# =================================================
# CONFIGURACIÓN DE LOGGING
# =================================================

# Habilitar logging de SQL (true/false)
SQL_LOGGING=true

# Nivel de log (error, warn, info, debug)
LOG_LEVEL=info
